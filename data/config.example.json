      "models": {
        "diffusion_model": {
          "directory": "diffusion_models",
          "file": "minimax_h3_image_pruned_int8_convrot.safetensors"
        },
        "text_encoder": {
          "directory": "text_encoders",
          "file": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors"
        },
        "vae": {
          "directory": "vae",
          "file": "minimax_h3_image_vae_fp16.safetensors"
