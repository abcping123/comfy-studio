{
  "schema_version": 9,
  "app": {
    "listen_host": "127.0.0.1",
    "port": 8765,
    "access_token": ""
  },
  "paths": {
    "runtime_root": "temp/runtime",
    "session_root": "temp/session",
    "output_archive": "output"
  },
  "chat_backends": {
    "strata": {
      "endpoint": "http://127.0.0.1:8080",
      "python": "~/repos/Strata/terminal/.venv/bin/python",
      "server_script": "~/repos/Strata/terminal/serve/server.py",
      "source_config_json": "~/repos/Strata/terminal/strata-q2_0.json",
      "runtime_config": "temp/runtime/strata_runtime.json",
      "api_key": "",
      "model": "qwen3.8-flash-next-q2_0",
      "idle_unload_s": 600,
      "max_tokens": 8192,
      "request_timeout_s": 900
    },
    "bonsai": {
      "endpoint": "http://127.0.0.1:9931",
      "server_binary": "~/repos/prism-llama.cpp/build/bin/llama-server",
      "model_file": "~/models/dealignai__Bonsai-2-27B-1bit-CRACK-GGUF/Bonsai-2-27B-PTQ1_0-CRACK.gguf",
      "mmproj_file": "~/models/prism-ml__Ternary-Bonsai-2-27B-gguf/Ternary-Bonsai-2-27B-mmproj-BF16.gguf",
      "mmproj_gpu_offload": false,
      "model": "local-model",
      "ctx_size": 32768,
      "n_gpu_layers": "all",
      "flash_attn": "on",
      "parallel": 1,
      "n_predict": 16384,
      "temperature": 1.0,
      "top_p": 0.95,
      "top_k": 20,
      "min_p": 0.05,
      "presence_penalty": 0.0,
      "repeat_penalty": 1.0,
      "max_tokens": 8192,
      "request_timeout_s": 900,
      "startup_timeout_s": 900
    }
  },
  "comfyui": {
    "endpoint": "http://127.0.0.1:8188",
    "python": "~/repos/ComfyUI/.venv/bin/python",
    "main_script": "~/repos/ComfyUI/main.py",
    "working_directory": "~/repos/ComfyUI",
    "model_directories": {
      "diffusion_models": "~/models/Comfy-Org__MiniMax-H3-Image/diffusion_models",
      "text_encoders": "~/models/Comfy-Org__MiniMax-H3-Image/text_encoders",
      "vae": "~/models/Comfy-Org__MiniMax-H3-Image/vae",
