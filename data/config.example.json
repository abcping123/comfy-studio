      }
    }
  },
  "generation": {
    "prompt_enhancement": false,
    "prompt_skill_version": 3,
    "aspect_ratios": [
      {"label": "1:1 (Square)", "width": 1, "height": 1},
      {"label": "2:3 (Portrait Photo)", "width": 2, "height": 3},
      {"label": "3:2 (Photo)", "width": 3, "height": 2},
      {"label": "3:4 (Portrait Standard)", "width": 3, "height": 4},
      {"label": "4:3 (Standard)", "width": 4, "height": 3},
      {"label": "9:16 (Portrait Widescreen)", "width": 9, "height": 16},
      {"label": "16:9 (Widescreen)", "width": 16, "height": 9},
      {"label": "21:9 (Ultrawide)", "width": 21, "height": 9}
    ],
    "default_aspect_ratio": "1:1 (Square)",
    "default_megapixels": 4.0,
    "resolution_multiple": 32,
    "steps": 6,
    "cfg": 1.0,
    "sampler_options": ["euler", "euler_cfg_pp", "euler_ancestral", "euler_ancestral_cfg_pp", "heun", "heunpp2", "exp_heun_2_x0", "exp_heun_2_x0_sde", "dpm_2", "dpm_2_ancestral", "lms", "dpm_fast", "dpm_adaptive", "dpmpp_2s_ancestral", "dpmpp_2s_ancestral_cfg_pp", "dpmpp_sde", "dpmpp_sde_gpu", "dpmpp_2m", "dpmpp_2m_cfg_pp", "dpmpp_2m_sde", "dpmpp_2m_sde_gpu", "dpmpp_2m_sde_heun", "dpmpp_2m_sde_heun_gpu", "dpmpp_3m_sde", "dpmpp_3m_sde_gpu", "ddpm", "lcm", "ipndm", "ipndm_v", "deis", "cfgpp_ud10_ab", "res_multistep", "res_multistep_cfg_pp", "res_multistep_ancestral", "res_multistep_ancestral_cfg_pp", "gradient_estimation", "gradient_estimation_cfg_pp", "er_sde", "seeds_2", "seeds_3", "sa_solver", "sa_solver_pece", "ddim", "uni_pc", "uni_pc_bh2"],
    "scheduler_options": ["simple", "sgm_uniform", "karras", "exponential", "ddim_uniform", "beta", "normal", "linear_quadratic", "kl_optimal"],
    "default_sampler": "euler",
    "default_scheduler": "simple"
